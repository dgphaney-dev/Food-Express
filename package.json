{
  "name": "foodexpress",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "FoodExpress — Sistema Completo de Steakhouse e Delivery com Painel Administrativo",
  "scripts": {
    "start": "node site/backend/server.js",
    "build": "npm --prefix site/frontend install && npm --prefix site/frontend run build",
    "dev": "node site/backend/server.js",
    "dev:backend": "node --watch site/backend/server.js",
    "start:backend": "node site/backend/server.js",
    "seed": "node site/backend/db/seedCli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:frontend": "npm --prefix site/frontend run dev",
    "build:frontend": "npm --prefix site/frontend run build",
    "lint:frontend": "npm --prefix site/frontend run lint"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.39.3",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^3.0.5"
  }
}
