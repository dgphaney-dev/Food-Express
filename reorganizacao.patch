-
-  const expectedBuf = Buffer.from(expectedSignature, 'utf-8');
-  const providedBuf = Buffer.from(providedSignature, 'utf-8');
-
-  if (
-    expectedBuf.length !== providedBuf.length ||
-    !crypto.timingSafeEqual(expectedBuf, providedBuf)
