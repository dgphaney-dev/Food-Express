-
-function base64UrlDecode(input) {
-  let str = input.replace(/-/g, '+').replace(/_/g, '/');
-  while (str.length % 4 !== 0) {
-    str += '=';
-  }
-  return Buffer.from(str, 'base64').toString('utf-8');
-}
