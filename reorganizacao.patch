-function base64UrlEncode(input) {
-  const buf = Buffer.isBuffer(input) ? input : Buffer.from(String(input), 'utf-8');
-  return buf
-    .toString('base64')
-    .replace(/=/g, '')
-    .replace(/\+/g, '-')
